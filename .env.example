# ==============================================================================
# EduPortal - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Server Port
PORT=3000

# JSON Web Token Secret Key
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production_2026

# Database Configuration ('postgres' or 'sqlite')
DB_TYPE=postgres

# PostgreSQL Connection String (e.g., Neon Cloud Serverless PostgreSQL)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Email / SMTP Service Configuration (e.g., Gmail SMTP or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
EMAIL_FROM="Student Portal Admin <your_email@gmail.com>"

# Optional Django Settings
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

